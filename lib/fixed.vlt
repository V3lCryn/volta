-- lib/fixed.vlt -- fixed-point arithmetic for Volta
--
-- Q16.16 format: 16 bits whole, 16 bits fraction, stored in an i64.
-- Uses only integer add/sub/mul/div/shift -- no FPU required.

const FX_SHIFT: i64 = 16
const FX_ONE:   i64 = 65536

fn fx_from_int(n: i64) -> i64
  return n * FX_ONE
end

fn fx_to_int(fx: i64) -> i64
  return fx / FX_ONE
end

fn fx_from_float(f: f64) -> i64
  return (f * 65536.0) as i64
end

fn fx_to_float(fx: i64) -> f64
  return (fx as f64) / 65536.0
end

fn fx_add(a: i64, b: i64) -> i64
  return a + b
end

fn fx_sub(a: i64, b: i64) -> i64
  return a - b
end

fn fx_mul(a: i64, b: i64) -> i64
  return (a * b) >> FX_SHIFT
end

fn fx_div(a: i64, b: i64) -> i64
  return (a << FX_SHIFT) / b
end

fn fx_abs(a: i64) -> i64
  if a < 0 do return -a end
  return a
end

fn fx_clamp(a: i64, lo: i64, hi: i64) -> i64
  if a < lo do return lo end
  if a > hi do return hi end
  return a
end

fn fx_lerp(a: i64, b: i64, t: i64) -> i64
  let diff = fx_sub(b, a)
  let scaled = fx_mul(diff, t)
  return fx_add(a, scaled)
end

fn fx_to_str(fx: i64) -> str
  let whole = fx_to_int(fx)
  let frac_fx = fx_sub(fx, fx_from_int(whole))
  let frac_abs = fx_abs(frac_fx)
  let frac_scaled = (frac_abs * 100000) / FX_ONE
  let frac_str = int_to_str(frac_scaled)
  while str_len(frac_str) < 5 do
    frac_str = "0" .. frac_str
  end
  return int_to_str(whole) .. "." .. frac_str
end
